# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional
OPENAI_API_KEY=
JUDGE_MODEL=anthropic/claude-haiku-4-5-20251001
AGENT_MODEL=anthropic/claude-sonnet-4-6
OLLAMA_BASE_URL=http://localhost:11434
# Decider — optional local "System 1" judge, shadowed alongside the incumbent
# LLM judge for metrics listed in DECIDER_METRICS. Off by default. Served by
# Ollama (>=0.35, for its /v1/systemone decision-model API) running a
# decision model named by DECIDER_MODEL ("nimble" or "tev1"). If Ollama is a
# native host process on Mac (for Metal acceleration, since no container
# runtime can reach the Apple GPU) reached from inside a container, use
# http://host.docker.internal:11434 here, not localhost.
DECIDER_ENABLED=false
DECIDER_BASE_URL=http://localhost:11434
DECIDER_MODEL=nimble
DECIDER_METRICS=bias_score,toxicity_score,coherence,conciseness,relevance,faithfulness,hallucination_score,instruction_following
# Strands Decider 2B — second, independent decision-model track (not Ollama).
# Served by its own `strands-decider serve <model> --port 8000` process. Same
# host.docker.internal note applies if run natively on Mac.
STRANDS_DECIDER_ENABLED=false
STRANDS_DECIDER_BASE_URL=http://localhost:8000
STRANDS_DECIDER_METRICS=bias_score,toxicity_score,coherence,conciseness,relevance,faithfulness,hallucination_score,instruction_following
# Gateway master key — protects all admin write endpoints (routing, shadow, A/B, keys, cache)
# Leave empty for open/dev mode (no auth required on admin endpoints)
GATEWAY_MASTER_KEY=

# Agent Gateway — OpenAI-compatible endpoint (M3)
# Set this in your agent environment to route all LLM calls through the gateway
OPENAI_BASE_URL=http://localhost:8080/v1

# LLM API Keys — at least one required
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   # alternative if using claude via gateway

# Model selection (gateway will route to whichever provider you set)
OPENAI_MODEL=gpt-4o-mini

# Ollama (optional — local models)
# OLLAMA_ENABLED=true
# OLLAMA_MODEL=gemma4:26b
# OLLAMA_BASE_URL=http://localhost:11434

# ── AI Control Plane connection ───────────────────────────────────────────────
# M1: OTel Collector — traces/spans
ACP_OTEL_ENDPOINT=http://localhost:4318

# M2: Governance Service — policy checks, gate enforcement
ACP_GOVERNANCE_URL=http://localhost:8002

# M3: Agent Gateway — routes all LLM calls
ACP_GATEWAY_URL=http://localhost:8080
OPENAI_BASE_URL=http://localhost:8080/v1
GATEWAY_API_KEY=

# Jaeger UI (for trace links in the chat)
PUBLIC_JAEGER_URL=http://localhost:16686

# ACP module toggles (set false to bypass that module)
# ACP_M1_ENABLED=true
# ACP_M2_ENABLED=true
# ACP_M3_ENABLED=true
